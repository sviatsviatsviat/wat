{
  "name": "wat",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=wat-workspace,target=/workspaces/wat,type=volume",
  "workspaceFolder": "/workspaces/wat",
  "remoteUser": "vscode",
  "runArgs": [
    "--init"
  ],
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspaces/wat/.devcontainer,type=bind,consistency=cached"
  ],
  "postStartCommand": "test -f go.mod && go mod download || true",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {
      "version": "2.96.0"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "CodeRabbit.coderabbit-vscode",
        "golang.go"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": false,
        "go.lintTool": "golangci-lint",
        "go.useLanguageServer": true
      }
    }
  }
}
