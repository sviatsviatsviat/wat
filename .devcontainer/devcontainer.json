{
  "name": "wat",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "workspaceMount": "source=wat-workspace,target=/workspaces/wat,type=volume",
  "workspaceFolder": "/workspaces/wat",
  "remoteUser": "vscode",
  "runArgs": [
    "--init"
  ],
  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer,target=/workspaces/wat/.devcontainer,type=bind,consistency=cached",
    "source=wat-claude-config,target=/home/vscode/.claude,type=volume"
  ],
  "containerEnv": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "postStartCommand": "sudo chown -R vscode:vscode /home/vscode/.claude && (test -f go.mod && go mod download || true)",
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.0": {
      "version": "2.96.0"
    },
    "ghcr.io/devcontainers-extra/features/golangci-lint:1.0.0": {
      "version": "2.12.2"
    },
    "ghcr.io/devcontainers-extra/features/ripgrep:1.0.15": {
      "version": "15.1.0"
    },
    "ghcr.io/devcontainers/features/node:2.1.0": {
      "version": "22.23.1",
      "pnpmVersion": "none"
    },
    "ghcr.io/anthropics/devcontainer-features/claude-code:1.0.5": {}
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "CodeRabbit.coderabbit-vscode",
        "golang.go"
      ],
      "settings": {
        "go.toolsManagement.autoUpdate": false,
        "go.lintTool": "golangci-lint",
        "go.useLanguageServer": true
      }
    }
  }
}
