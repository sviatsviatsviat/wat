{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "/go/bin/wat run --agent cursor --event sessionStart"
      }
    ],
    "subagentStart": [
      {
        "type": "command",
        "command": "/go/bin/wat run --agent cursor --event subagentStart"
      }
    ]
  }
}
